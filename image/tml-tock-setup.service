# Writes tock's config for the DUT wired to this host, and declares one
# service per transport that DUT supports. Must finish before Treadmill's
# in-image daemon reads /etc/tml/services.d, or the services go unannounced
# for the life of the job.
#
# Runs as root, not as tml: /etc/tml/services.d is root-owned, so a tml
# process cannot write a declaration there. Verified on a live host -- the
# agent fails with EACCES. The config it writes still has to land in tml's
# home, because the brokers run as tml and that is where `tock` looks.
[Unit]
After=network.target
# Order this before whatever unit runs Treadmill's in-image daemon. Named
# here rather than assumed, because getting it wrong fails silently: the
# daemon simply sees an empty services directory.
# Before=tml-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/tml-tock-agent --config /home/tml/.config/tock/config.toml
ExecStartPost=/bin/chown -R tml:tml /home/tml/.config/tock

[Install]
WantedBy=multi-user.target
