# One instance per tock transport: tml-tock-broker@openocd.service,
# tml-tock-broker@serial.service. %i is the transport name, which is both
# the socket directory's suffix and the argument tock is pinned to.
#
# websocat terminates the WebSocket the developer's end opens through the
# job gateway and hands the connection to a freshly spawned broker. That is
# the whole carrier: nothing in tml-tock-agent moves bytes.
#
# CONCURRENCY, measured rather than assumed. websocat does not exit between
# connections here: it keeps listening and spawns one broker per connection,
# each exiting when its connection closes. So nothing serialises them, and
# two clients at once get two brokers -- the second failing in OpenOCD with
# `LIBUSB_ERROR_BUSY` / `No J-Link device found`, because a debug probe
# cannot be shared.
#
# An earlier version of this comment claimed `--exit-on-eof` plus `Restart=`
# provided that serialisation. It does not; `NRestarts` stays 0 across many
# connections.
#
# Left as-is deliberately. Sequential use -- the actual development loop --
# works, and concurrent use of one board means a developer racing themselves
# on a host they hold exclusively. It fails loudly rather than corrupting
# anything. If it becomes a real problem, a `.socket` unit with
# `Accept=yes` and `MaxConnections=1` is the fix, at the cost of refusing
# the second connection rather than explaining it.
[Unit]
After=network.target tml-tock-setup.service
Requires=tml-tock-setup.service

[Service]
User=tml
Group=tml
RuntimeDirectory=tml-tock-%i
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/websocat --binary --exit-on-eof \
    ws-u:unix-l:/run/tml-tock-%i/broker.sock \
    exec:tock --exec-args --transport %i broker
Restart=always
# Deliberately 0, where the image's SSH service uses 5s. An ssh client
# retries a refused connection; tock-transport-treadmill does not, and a
# developer runs `tock flash` then `tock console` back to back. A restart
# gap here is a failed command, not a blip.
RestartSec=0

[Install]
WantedBy=multi-user.target
